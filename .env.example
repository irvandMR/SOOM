# Environment Variables Template
# Copy this file to .env and fill in the actual values for your environment

# ─────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────
DB_HOST=postgresql://postgres:Adminsoom@123@db.yrjzubnyodtieazvrsnk.supabase.co:5432/postgres
DB_PORT=5432
DB_NAME=soom_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password_here

# ─────────────────────────────────────
# Redis Configuration
# ─────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─────────────────────────────────────
# Email Configuration (Gmail SMTP)
# ─────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here

# ─────────────────────────────────────
# JWT Configuration
# ─────────────────────────────────────
# Generate a strong secret key for production
# Use: openssl rand -base64 32
JWT_SECRET=your_super_secret_key_here_minimum_32_chars
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ─────────────────────────────────────
# Frontend Configuration
# ─────────────────────────────────────
VITE_API_URL=http://localhost:8081/api/v1

# ─────────────────────────────────────
# Optional: For Production Deployment
# ─────────────────────────────────────
# API_BASE_URL=https://api.yourdomain.com
# FRONTEND_URL=https://yourdomain.com
# LOG_LEVEL=warn
